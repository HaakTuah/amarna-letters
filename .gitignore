*.pyc

# Logs and test output
*.log
npm-debug.log*
test-results/
coverage/

# Editors and operating systems
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
