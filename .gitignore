# Vim temporary swap files
*.swp

# Simulation kit: per-run folders, secret words and the king and character agent types made by sim/setup.js
/sim/kings/
/sim/characters/
/sim/runs/
/.claude/agents/king-*.md
/.claude/agents/char-*.md

# Claude Code: local-only files
.claude/settings.local.json
.claude/worktrees/

# TypeScript build output
/.tsbuild/
/src/web/dist/
*.tsbuildinfo
/soak.png
