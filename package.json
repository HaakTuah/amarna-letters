{
  "name": "amarna-letters",
  "private": true,
  "type": "module",
  "workspaces": [
    "src/engine",
    "src/game",
    "src/llm",
    "src/web",
    "src/batch"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p src/web",
    "test": "vitest run",
    "lint": "eslint src && node scripts/unused-code.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.4",
    "@isaacs/nonrecursive-glob-match": "1.0.3"
  }
}
