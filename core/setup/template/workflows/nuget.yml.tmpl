# The NuGet check (floor rules 7, 10 and 15), on every pull request, Dependabot's included: the core's. It restores
# each project file git knows from its lock file alone and holds every package to its licence list and to one exact
# version, reading the licence check's config and its "nuget". Read-only, and no secrets. It starts advisory: it says
# what it would fail and passes.
name: nuget

on:
  pull_request:

permissions:
  contents: read

jobs:
  nuget:
    uses: {{core}}/.github/workflows/nuget.yml@{{pin}}
    with:
      config: checks/licences.json
      advisory: true # FILL IN: false, once the check has been right for a week of the project's pull requests
