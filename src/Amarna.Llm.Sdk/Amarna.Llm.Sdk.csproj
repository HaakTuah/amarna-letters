<Project Sdk="Microsoft.NET.Sdk">

  <!-- The official Anthropic SDK, for console programs (the batch runner, tests). The browser posts its requests with
       HttpClient instead (see ClaudeClient), so the web app does not reference this project and never downloads the SDK. -->
  <ItemGroup>
    <ProjectReference Include="..\Amarna.Llm\Amarna.Llm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.58.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
