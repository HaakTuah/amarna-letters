@page "/"
@inject GameSession Session
@inject Storage Store
@inject KeyHolder Keys
@inject NavigationManager Nav

<PageTitle>Amarna Letters</PageTitle>

<div class="page">
    <h1>Amarna Letters</h1>
    <p class="muted" style="max-width:46rem">
        Seven Great Kings of the Late Bronze Age. The engine enforces movement, combat and gold; every treaty,
        alliance and betrayal is invented by the players. Kings never speak to each other directly: every word
        travels with an envoy, who has motives of their own.
    </p>

    <div class="card">
        <h2>How do you want to play?</h2>
        <div class="presets" role="radiogroup" aria-label="Game presets">
            @foreach (var p in Presets.All)
            {
                var on = Selected?.Id == p.Id;
                var estimate = EstimateFor(p);
                <button class="preset @(on ? "on" : "")" role="radio" aria-checked="@(on ? "true" : "false")" aria-label="@($"{p.Name}: {CostEstimate.Describe(estimate)}")" @onclick="() => Choose(p)">
                    <span class="preset-head">
                        <strong>@p.Name</strong>
                        @if (p == Presets.Standard) { <span class="pill">recommended</span> }
                    </span>
                    <span class="preset-models">@Roles(p)</span>
                    <span class="preset-text">@p.Tagline</span>
                    <span class="preset-foot">
                        <span class="pill">@CostEstimate.Describe(estimate)@(estimate > 0 ? " a game" : "")</span>
                        <small class="muted">@(p.NeedsKey ? "your API key" : "no key needed")</small>
                    </span>
                </button>
            }
        </div>
        @if (Selected is null)
        {
            <p class="notice">Custom setup: @Summary(). Estimated @CostEstimate.Describe(Settings.Estimate)@(Settings.Estimate > 0 ? " a game" : "").</p>
        }

        <div class="row" style="margin-top:.9rem">
            <label>
                <span class="muted">Your seat</span>
                <select value="@(Seat?.ToString() ?? "")" @onchange="ChangeSeat">
                    <option value="">Watch the kings (spectator)</option>
                    @foreach (var p in Powers.All) { <option value="@p">Play as @p.Name() (@p.Tier().ToString().ToLowerInvariant())</option> }
                </select>
            </label>
        </div>

        <details class="customize" open="@Customizing" @ontoggle="() => Customizing = !Customizing">
            <summary>Customize the table</summary>
            <div class="grid2" style="margin-top:.7rem">
                <div>
                    <table>
                        <thead><tr><th>Power</th><th>Tier</th><th>Played by</th></tr></thead>
                        <tbody>
                            @foreach (var p in Powers.All)
                            {
                                <tr>
                                    <td><span class="dot" style="background:@Ui.Color(p)"></span> @p.Name()</td>
                                    <td class="muted">@p.Tier()</td>
                                    <td>
                                        <select value="@Settings.Choices.Leaders[p]" @onchange="e => SetLeader(p, (string)e.Value!)">
                                            <option value="@LeaderKind.Script">Script bot</option>
                                            <option value="@LeaderKind.Human">Human (you)</option>
                                            <option value="@LeaderKind.Haiku">Haiku 5.5</option>
                                            <option value="@LeaderKind.Sonnet">Sonnet 5.5</option>
                                            <option value="@LeaderKind.Opus">Opus 5.5</option>
                                        </select>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div>
                    <div class="field">
                        <span>Envoys, spies and candidates</span>
                        <select value="@Settings.Choices.Characters" @onchange="e => { Settings.Choices.Characters = Enum.Parse<CharacterKind>((string)e.Value!); Recost(); }">
                            <option value="@CharacterKind.Script">Script characters (free)</option>
                            <option value="@CharacterKind.Haiku">Haiku 5.5</option>
                            <option value="@CharacterKind.Sonnet">Sonnet 5.5 (sharper, costs more)</option>
                        </select>
                    </div>
                    <div class="field">
                        <span>Narrator (personas, check reports, chronicles)</span>
                        <select value="@Settings.Choices.Narrator" @onchange="e => { Settings.Choices.Narrator = Enum.Parse<NarratorKind>((string)e.Value!); Recost(); }">
                            <option value="@NarratorKind.Template">Template narrator (free)</option>
                            <option value="@NarratorKind.Haiku">Haiku 5.5</option>
                            <option value="@NarratorKind.Sonnet">Sonnet 5.5</option>
                            <option value="@NarratorKind.Opus">Opus 5.5</option>
                        </select>
                    </div>
                    <div class="field">
                        <span>How hard model kings think</span>
                        <select value="@Settings.Choices.LeaderEffort" @onchange="e => { Settings.Choices.LeaderEffort = (string)e.Value!; Recost(); }">
                            <option value="low">Low (cheaper, quicker)</option>
                            <option value="medium">Medium</option>
                            <option value="high">High (deeper, costs more)</option>
                        </select>
                    </div>
                    <div class="row">
                        <label><input type="checkbox" @bind="Settings.Chronicles" /> Chronicles at the end</label>
                        <label><input type="checkbox" @bind="Settings.CustomsPrimer" /> Customs primer for kings</label>
                        <label><input type="checkbox" @bind="Settings.SharedVictory" /> Shared victory for sworn allies</label>
                    </div>
                    <div class="row" style="margin-top:.6rem">
                        <label title="The world still moves every season; a model king is called only when something concerns it, or when the time it chose has come. Script and human kings play every season."><input type="checkbox" @bind="Settings.SleepingSeats" /> Sleeping seats for model kings</label>
                        @if (Settings.SleepingSeats)
                        {
                            <label>Longest sleep (seasons) <input type="number" min="1" max="30" @bind="Settings.MaxSleep" /></label>
                        }
                    </div>
                    <div class="row" style="margin-top:.6rem">
                        <label>Envoys per season <input type="number" min="1" max="6" @bind="Settings.MessagesPerTurn" /></label>
                        <label>Seed <input type="number" min="1" @bind="SeedText" /></label>
                    </div>
                    <label style="margin-top:.6rem">
                        <input type="checkbox" @bind="Settings.SimulateApi" />
                        Simulate the API (canned replies, nothing leaves the browser, no cost: for testing the app)
                    </label>
                </div>
            </div>
        </details>

        @if (Settings.UsesModels && !Settings.SimulateApi)
        {
            <div class="section">
                <h3>Your Anthropic API key</h3>
                <p class="muted">
                    Model calls go straight from this page to the Anthropic API with your own key. The key stays in this tab's
                    memory (and, if you tick the box, in this tab's session storage); it is never written to local storage, a
                    cookie or any server. Use a dedicated key with a spend limit set in the Anthropic Console.
                </p>
                <div class="row">
                    <input type="password" style="width:28rem" placeholder="sk-ant-..." autocomplete="off" @bind="Keys.Key" />
                    <label><input type="checkbox" @bind="Keys.Remember" /> Keep for this tab</label>
                </div>
                <p style="margin-top:.6rem">
                    Estimated cost: <strong>@CostEstimate.Describe(Settings.Estimate)</strong> for a typical @CostEstimate.TypicalSeasons-season game
                    (a rough figure: the meter in the game shows the real spend).
                    <label>The game pauses at $<input type="number" min="0.5" step="0.5" value="@Settings.BudgetUsd" @onchange="SetBudget" /></label>
                </p>
            </div>
        }

        @if (Problem is not null)
        {
            <div class="notice error">@Problem</div>
        }
        <div class="row" style="margin-top:.8rem">
            <button class="primary" disabled="@Starting" @onclick="Start">Begin the age</button>
            @if (Session.Runner is not null)
            {
                <button @onclick='() => Nav.NavigateTo("play")'>Return to the current game</button>
            }
        </div>
    </div>

    <div class="card">
        <h2>Saved games and replays</h2>
        <p class="muted">Every game is saved in this browser as an event log. A log replays the game exactly, season by season.</p>
        <div class="row" style="margin-bottom:.6rem">
            <InputFile OnChange="Picked" accept=".jsonl,.json,.txt" />
            @if (LoadedText is not null)
            {
                <button @onclick="() => Load(LoadedText, false)">Watch replay</button>
                <button @onclick="() => Load(LoadedText, true)">Continue playing</button>
            }
        </div>
        @if (Saved.Count == 0)
        {
            <p class="muted">No saved games yet.</p>
        }
        else
        {
            <table>
                <tbody>
                    @foreach (var s in Saved.Take(15))
                    {
                        <tr>
                            <td>@s.Meta<br /><small>@DateTimeOffset.FromUnixTimeMilliseconds((long)s.Saved).LocalDateTime.ToString("yyyy-MM-dd HH:mm")</small></td>
                            <td style="text-align:right">
                                <button class="small" @onclick="() => LoadSaved(s.Id, false)">Replay</button>
                                <button class="small" @onclick="() => LoadSaved(s.Id, true)">Continue</button>
                                <button class="small danger" @onclick="() => Delete(s.Id)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private GameSettings Settings { get; set; } = NewSettings();
    private List<SavedLog> Saved { get; set; } = new();
    private string? LoadedText;
    private string? Problem;
    private bool Starting;
    private bool Customizing;
    private bool _budgetTouched;

    private static GameSettings NewSettings()
    {
        var s = new GameSettings();
        Presets.Free.ApplyTo(s.Choices);
        return s;
    }

    private Preset? Selected => Presets.Matching(Settings.Choices);

    private Power? Seat => Settings.Choices.Leaders.Where(x => x.Value == LeaderKind.Human).Select(x => (Power?)x.Key).FirstOrDefault();

    private long SeedText
    {
        get => (long)Settings.Seed;
        set => Settings.Seed = (ulong)Math.Max(1, value);
    }

    protected override async Task OnInitializedAsync()
    {
        Keys.Key ??= await Store.GetSessionKeyAsync();
        if (Keys.Key is not null) Keys.Remember = true;
        Saved = await Store.ListAsync();
        Recost();
    }

    private static string Name(LeaderKind k) => k switch { LeaderKind.Script => "script", LeaderKind.Human => "you", _ => $"{k} 5.5" };

    private static string Roles(Preset p) =>
        $"Kings: {Name(p.Leaders)} · Envoys: {(p.Characters == CharacterKind.Script ? "script" : $"{p.Characters} 5.5")} · Narrator: {(p.Narrator == NarratorKind.Template ? "template" : $"{p.Narrator} 5.5")}";

    private string Summary()
    {
        var kings = Settings.Choices.Leaders.Where(x => x.Value != LeaderKind.Human).GroupBy(x => x.Value)
            .Select(g => $"{g.Count()} {Name(g.Key)}");
        return $"kings {string.Join(", ", kings)}; envoys {Settings.Choices.Characters.ToString().ToLowerInvariant()}; narrator {Settings.Choices.Narrator.ToString().ToLowerInvariant()}";
    }

    private double EstimateFor(Preset p)
    {
        var c = Settings.Choices.Copy();
        p.ApplyTo(c);
        return CostEstimate.PerGame(c);
    }

    private void Choose(Preset p)
    {
        p.ApplyTo(Settings.Choices);
        Recost();
    }

    private void ChangeSeat(ChangeEventArgs e)
    {
        var preset = Selected ?? Presets.Free;
        foreach (var p in Powers.All)
            if (Settings.Choices.Leaders[p] == LeaderKind.Human) Settings.Choices.Leaders[p] = preset.Leaders;
        if (Enum.TryParse<Power>((string?)e.Value, out var seat)) Settings.Choices.Leaders[seat] = LeaderKind.Human;
        Recost();
    }

    private void SetLeader(Power p, string value)
    {
        Settings.Choices.Leaders[p] = Enum.Parse<LeaderKind>(value);
        Recost();
    }

    private void SetBudget(ChangeEventArgs e)
    {
        if (double.TryParse((string?)e.Value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v))
        {
            Settings.BudgetUsd = Math.Max(0.5, v);
            _budgetTouched = true;
        }
    }

    /// <summary>Keeps the spending cap in step with the estimate until the player sets it themselves.</summary>
    private void Recost()
    {
        if (!_budgetTouched) Settings.BudgetUsd = CostEstimate.SuggestedBudget(Settings.Estimate);
    }

    private async Task<bool> KeyReady()
    {
        Problem = null;
        if (!Settings.UsesModels || Settings.SimulateApi) return true;
        if (string.IsNullOrWhiteSpace(Keys.Key))
        {
            Problem = "This setup uses Claude models: enter your Anthropic API key above, or choose Free.";
            return false;
        }
        await Store.SetSessionKeyAsync(Keys.Remember ? Keys.Key : null);
        return true;
    }

    private async Task Start()
    {
        if (!await KeyReady()) return;
        Starting = true;
        var settings = Settings.Copy();
        Settings.Seed = (ulong)Random.Shared.Next(1, 1_000_000);
        Nav.NavigateTo("play");
        await Session.StartAsync(settings, Keys.Key);
        Starting = false;
    }

    private async Task Picked(InputFileChangeEventArgs e)
    {
        using var stream = e.File.OpenReadStream(maxAllowedSize: 64 * 1024 * 1024);
        using var reader = new StreamReader(stream);
        LoadedText = await reader.ReadToEndAsync();
    }

    private async Task Load(string text, bool continuePlay)
    {
        LogHeader? header = null;
        try { header = GameLog.FromJsonl(text).Header; }
        catch (Exception) { } // not a log: the game page says so
        // A game saved under other rules cannot be replayed or continued: say so here, before anything else.
        if (header is not null && GameRunner.VersionProblem(header) is { } old)
        {
            Problem = old;
            return;
        }
        if (continuePlay && header is not null)
        {
            if (SeatSetup.FromHeader(header).UsesModels && string.IsNullOrWhiteSpace(Keys.Key))
            {
                Problem = "This game used Claude models. Choose any preset that needs a key, enter your key, then continue.";
                return;
            }
        }
        Nav.NavigateTo("play");
        await Session.LoadAsync(text, continuePlay, Keys.Key);
    }

    private async Task LoadSaved(string id, bool continuePlay)
    {
        var text = await Store.LoadAsync(id);
        if (text is null) { Problem = "That saved game could not be read."; return; }
        await Load(text, continuePlay);
    }

    private async Task Delete(string id)
    {
        await Store.DeleteAsync(id);
        Saved = await Store.ListAsync();
    }
}
