<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- The app runs in the invariant culture already (Program.cs), so the ICU data need not be downloaded. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- An installable web app: the published build caches itself (wwwroot/service-worker.published.js). -->
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.1" PrivateAssets="all" />
  </ItemGroup>

  <!-- The browser never builds the Anthropic SDK client (it posts with HttpClient: see ClaudeClient), so the SDK, which
       the batch runner uses, is trimmed to what the code references instead of shipping whole (about 2 MB compressed). -->
  <ItemGroup>
    <TrimmableAssembly Include="Anthropic" />
    <TrimmableAssembly Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Amarna.Llm\Amarna.Llm.csproj" />
  </ItemGroup>

</Project>
