@{
    var engine = new TurnEngine(State);
    var latest = State.Scores.Count == 0 ? 0 : State.Scores.Max(s => s.Turn);
    var known = Viewer is null;
    // The estimate every court can make from who holds what: the same figures a model king reads on its LAND STANDINGS line.
    var land = Views.LandStandings(State.Owner, State.Eliminated).ToDictionary(x => x.Power);
    // A seat sees its own strength and gold by its ledger (unassayed gold at its weight), never the true figures.
    double Growth(Power p) => known ? engine.Growth(p)
        : State.StartStrength.GetValueOrDefault(p) is > 0 and var start && State.IsAlive(p) ? (double)engine.LedgerStrength(p) / start : 0;
}
<h3>Standings</h3>
<p class="muted">The winner is whoever grew most relative to where they began. @(known ? "" : "You see only your own figures; rivals' treasuries are private.") The land-yield ratio is what any court can reckon from who holds what: the yield of the land a power holds now over its homeland's yield at the start. It is not growth, which counts treasuries and back pay too, against a starting strength that includes the starting treasury.</p>
<div class="tablewrap"><table>
    <thead><tr><th>Power</th><th>Land-yield ratio (not growth)</th><th>Growth</th><th>Lands</th><th>Units</th><th>Gold</th></tr></thead>
    <tbody>
        @foreach (var p in Powers.All.OrderByDescending(p => known ? engine.Growth(p) : land[p].Fallen ? -1 : land[p].Growth))
        {
            var mine = known || p == Viewer;
            <tr>
                <td><Emblem Power="p" /> @p.Name() @(State.IsAlive(p) ? "" : "(fallen)")</td>
                <td>@(land[p].Fallen ? "-" : $"{land[p].Growth:0.00} ({land[p].Yield} of {land[p].StartYield})")</td>
                <td>@(mine ? Growth(p).ToString("0.00") : "?")</td>
                <td>@State.OwnedBy(p).Count()</td>
                <td>@(mine ? State.Units.Count(u => u.Power == p).ToString() : "?")</td>
                <td>@(mine ? Ui.Shekels(known ? State.Treasuries[p].Gold : State.Treasuries[p].Ledger) : "?")</td>
            </tr>
        }
    </tbody>
</table></div>

@if (State.Ended)
{
    // Shown once the age has ended, to every viewer: during play a character knows its own wealth, never the ranking.
    var ranking = Wealth.Ranking(State);
    <h4 style="margin-top:1rem">The richest characters</h4>
    <p class="muted">Beside the kings' standings, the people of the age ranked by their wealth: the second game, played under the kings', in which the greedy have a victory of their own. @Wealth.WhatCounts</p>
    <div class="tablewrap"><table>
        <thead><tr><th>#</th><th>Character</th><th>At the end</th><th>Wealth</th><th>Purse</th><th>Back pay owed</th><th>Where the gold came from</th></tr></thead>
        <tbody>
            @foreach (var (w, i) in ranking.Select((w, i) => (w, i)))
            {
                <tr>
                    <td>@(i + 1)</td>
                    <td>@w.Character.Name <span class="muted">of @w.Character.Origin</span></td>
                    <td>@Wealth.Standing(w.Character)</td>
                    <td>@Ui.Shekels(w.Total)</td>
                    <td>@Ui.Shekels(w.Purse)</td>
                    <td>@Ui.Shekels(w.BackPay)</td>
                    <td>@Wealth.Sources(w.Character.Earned)</td>
                </tr>
            }
        </tbody>
    </table></div>
}

<h4 style="margin-top:1rem">Opening positions (known to every court)</h4>
<p class="muted">Each king began with these troops and this treasury, holding its whole homeland. Its starting strength is @State.Config.ProvinceWeight × its homeland yield + its treasury, and its growth is measured against it.</p>
<div class="tablewrap"><table>
    <thead><tr><th>Power</th><th>Opening troops</th><th>Treasury</th><th>Homeland yield</th><th>Starting strength</th></tr></thead>
    <tbody>
        @foreach (var o in OpeningPositions.For(State.Config))
        {
            <tr>
                <td><Emblem Power="o.Power" /> @o.Power.Name()</td>
                <td>@o.Troops</td>
                <td>@o.Gold shekels</td>
                <td>@o.HomelandYield</td>
                <td>@o.Strength</td>
            </tr>
        }
    </tbody>
</table></div>

@if (known)
{
    <h4 style="margin-top:1rem">The kings</h4>
    <p class="muted">Script kings play by temperament: each power has its own, varied a little in every game. A model king falls back on the same script temperament whenever a call to the model fails.</p>
    <ul class="kings">
        @foreach (var p in Powers.All)
        {
            var seat = Seats?.GetValueOrDefault(p) ?? "";
            // The script seat's temperament, drawn from its own seat seed, derived from the game's seed as the seat derives it.
            var t = Amarna.Game.Bots.ScriptLeader.Temperament(p, State.Seed);
            <li>
                <Emblem Power="p" />
                <strong>@p.Name()</strong> <span class="muted">@seat</span>
                @if (seat != "Human")
                {
                    <div>@(seat.EndsWith("leader") ? "Stand-in: " : "")<em>@t.Epithet</em> (@string.Join(", ", t.Highlights())). <span class="muted">@t.Description</span></div>
                }
                @if (State.Config.SleepingSeats && State.Sleep.TryGetValue(p, out var sleep))
                {
                    var spells = sleep.History.Count;
                    var lengths = sleep.History.Where(h => h.WokeAt > 0).Select(h => h.WokeAt - h.From).ToList();
                    var last = sleep.History.LastOrDefault(h => h.WokeAt > 0);
                    <div class="muted">@(sleep.Asleep ? $"Asleep since {Ui.When(sleep.LastCalled + 1, null)}, wakes by {Ui.When(sleep.WakeAt, null)} at the latest." : "Awake.") @(lengths.Count > 0 ? $"Has slept {lengths.Count} time{(lengths.Count == 1 ? "" : "s")}, for {string.Join(", ", lengths)} season{(lengths.Count == 1 && lengths[0] == 1 ? "" : "s")}; last woken in {Ui.When(last!.WokeAt, null)} by: {string.Join("; ", last!.Reasons)}." : spells > 0 ? "Sleeping for the first time." : "Has not slept yet.") @(sleep.Courts.Count > 0 ? $"Held court with its orders standing {sleep.Courts.Count} time{(sleep.Courts.Count == 1 ? "" : "s")}, reopening them {sleep.Courts.Count(c => c.Reopened)}{(sleep.Courts.Count(c => !c.Decided) is > 0 and var stood ? $"; asked for orders after a failed call {stood}" : "")}." : "")</div>
                }
            </li>
        }
    </ul>
}

@if (known && latest > 0)
{
    var max = Math.Max(1.5, State.Scores.Max(s => s.Growth));
    var w = 600.0;
    var h = 200.0;
    <h4 style="margin-top:1rem">Growth over time</h4>
    <svg viewBox="0 0 @w @(h + 20)" style="width:100%;height:auto" role="img" aria-label="Growth of each power by turn">
        <line x1="0" y1="@Y(1, max, h)" x2="@w" y2="@Y(1, max, h)" stroke="var(--line)" stroke-dasharray="4 4" />
        <text x="2" y="@(Y(1, max, h) - 4)" font-size="11" fill="var(--muted)">start</text>
        @foreach (var p in Powers.All)
        {
            var rows = State.Scores.Where(s => s.Power == p).OrderBy(s => s.Turn).ToList();
            var pts = string.Join(" ", rows.Select(r => $"{F(X(r.Turn, latest, w))},{F(Y(r.Growth, max, h))}"));
            <polyline points="@pts" fill="none" stroke="@Ui.Color(p)" stroke-width="2.2" />
        }
        <text x="0" y="@(h + 16)" font-size="11" fill="var(--muted)">@Calendar.Short(1)</text>
        <text x="@w" y="@(h + 16)" font-size="11" fill="var(--muted)" text-anchor="end">@Ui.When(latest, Viewer)</text>
    </svg>
    <div class="row">@foreach (var p in Powers.All) { <span class="pill"><Emblem Power="p" />@p.Name()</span> }</div>
}

@code {
    [Parameter, EditorRequired] public GameState State { get; set; } = default!;
    [Parameter] public Power? Viewer { get; set; }
    /// <summary>Who sits in each seat (log header labels), to show script kings' temperaments in god view.</summary>
    [Parameter] public Dictionary<Power, string>? Seats { get; set; }

    private static double X(int turn, int last, double w) => last <= 1 ? 0 : (turn - 1) * w / (last - 1);
    private static double Y(double g, double max, double h) => h - g / max * h + 4;
    private static string F(double v) => v.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
}
