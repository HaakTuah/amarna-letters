@* The map's key, compact: opened from the map and closed back to it. Icons reuse the map's own symbols. *@
<div class="legend map-ui" role="dialog" aria-label="Map legend">
    <div class="legend-head"><strong>Legend</strong> <button class="small" @onclick="OnClose" aria-label="Close the legend">✕</button></div>
    <div class="legend-grid">
        <span><svg viewBox="-12 -12 24 24"><rect class="tok-bg lg" x="-11" y="-11" width="22" height="22" rx="4" /><use href="#g-army" class="tok-icon" x="-9.5" y="-9.5" width="19" height="19" /></svg> army (chariots)</span>
        <span><svg viewBox="-12 -12 24 24"><circle class="tok-bg lg" r="11.5" /><use href="#g-fleet" class="tok-icon" x="-9.5" y="-9.5" width="19" height="19" /></svg> fleet</span>
        <span><svg viewBox="-12 -12 24 24"><rect class="tok-bg ghost-lg" x="-11" y="-11" width="22" height="22" rx="4" /><use href="#g-army" class="tok-icon dim" x="-9.5" y="-9.5" width="19" height="19" /></svg> seen before, not now</span>
        <span><svg viewBox="-10 -10 20 20"><rect class="chip-bg lg" x="-8" y="-8" width="16" height="16" rx="3.5" /><use href="#g-tablet" class="chip-icon" x="-6" y="-6" width="12" height="12" /></svg> envoy</span>
        <span><svg viewBox="-10 -10 20 20"><rect class="chip-bg lg" x="-8" y="-8" width="16" height="16" rx="3.5" /><use href="#g-eye" class="chip-icon" x="-6.5" y="-6.5" width="13" height="13" /></svg> spy at a post</span>
        <span><svg viewBox="-10 -10 20 20"><rect class="chip-bg lg" x="-8" y="-8" width="16" height="16" rx="3.5" /><use href="#g-fetter" class="chip-icon" x="-6.5" y="-6.5" width="13" height="13" /></svg> captive or detained</span>
        <span><svg viewBox="-10 -10 20 20"><use href="#g-ingot" class="ingot lg" x="-9" y="-9" width="18" height="18" /></svg> gold on the road</span>
        <span><svg viewBox="-12 -12 24 24"><circle class="halo" r="11" /><rect class="chip-bg lg" x="-7" y="-7" width="14" height="14" rx="7" /></svg> traveller (place guessed)</span>
        <span><svg viewBox="-10 -10 20 20"><path class="news-bg" d="M-9,-7H9V5H2L-2,9V5H-9Z" /><text class="news-q" y="3">?</text></svg> rumour or report</span>
        <span><svg viewBox="-12 -12 24 24"><use href="#g-crown" class="crown" x="-7" y="-12" width="14" height="14" /><circle class="seal s-free" r="6" cy="4" /></svg> capital</span>
        <span><svg viewBox="-12 -12 24 24"><circle class="walls" r="9" /><circle class="seal s-free" r="6" /></svg> walled free city</span>
        <span><svg viewBox="0 0 40 14"><path class="lg-arrow" d="M2,7H32" /><path class="lg-head" d="M30,2L38,7L30,12Z" /></svg> move</span>
        <span><svg viewBox="0 0 40 14"><path class="lg-arrow" d="M2,7H30" /><use href="#g-burst" class="burst" x="27" y="0" width="13" height="13" /></svg> attack</span>
        <span><svg viewBox="0 0 40 14"><path class="lg-arrow" d="M2,7H22" /><path class="lg-bar" d="M23,1V13" /></svg> bounced</span>
        <span><svg viewBox="0 0 40 14"><path class="lg-sup" d="M2,7H32" /><circle class="lg-dot" cx="34" cy="7" r="3" /></svg> support</span>
        <span><svg viewBox="-12 -12 24 24"><circle class="lg-cap" r="9" /></svg> changed hands</span>
        <span><svg viewBox="0 0 30 14"><rect width="30" height="14" class="lg-fog" fill="url(#fog)" /></svg> out of sight: the denser, the older</span>
        <span><svg viewBox="0 0 30 14"><rect width="30" height="14" class="lg-fert" fill="url(#fert4)" /></svg> rich land (close furrows)</span>
        <span><svg viewBox="0 0 30 14"><rect width="30" height="14" class="lg-desert" fill="url(#stipple)" /></svg> desert</span>
        <span><svg viewBox="0 0 30 14"><path class="peaks" d="M2,12L8,4L14,12M14,12L20,3L26,12" /></svg> mountains, rough ground</span>
        <span><svg viewBox="0 0 30 14"><path class="pass-lg" d="M11,1Q15,7 11,13M19,1Q15,7 19,13" /></svg> pass · <svg viewBox="0 0 30 14"><path class="ford-lg" d="M12,1V13M18,1V13" /></svg> river crossing</span>
    </div>
    <p class="muted small">Terrain has no effect yet. Each power has a colour, an emblem and its own border line:</p>
    <div class="legend-powers">
        @foreach (var p in Powers.All)
        {
            <span><Emblem Power="p" /> @p.Name() <svg class="lg-band" viewBox="0 0 36 8"><line x1="0" y1="4" x2="36" y2="4" class="@($"band b-{p.ToString().ToLowerInvariant()}")" stroke-dasharray="@Amarna.Web.Components.Map.Glyphs.Dash(p)" /></svg></span>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
}
