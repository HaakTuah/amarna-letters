@* After the game: two nations' self-serving annals side by side, against the true record. *@
<h3>The annals</h3>
<p class="muted">Each court wrote its own history, as Egypt and Hatti both recorded Kadesh as a victory. Compare them with the record.</p>
<div class="row" style="margin-bottom:.6rem">
    <select @bind="Left">@foreach (var p in Runner.Chronicles.Keys) { <option value="@p">@p.Name()</option> }</select>
    <select @bind="Right">@foreach (var p in Runner.Chronicles.Keys) { <option value="@p">@p.Name()</option> }</select>
</div>
<div class="trail" style="grid-template-columns:repeat(2,minmax(0,1fr))">
    <div class="chronicle">@Runner.Chronicles.GetValueOrDefault(Left)</div>
    <div class="chronicle">@Runner.Chronicles.GetValueOrDefault(Right)</div>
</div>
<h4 style="margin-top:1rem">The true record between them</h4>
@foreach (var e in Runner.State.Events.Where(e => e.Text.Contains(Left.ToString()) || e.Text.Contains(Right.ToString())).Where(e => e.Kind is not "support").TakeLast(60))
{
    <div><small class="muted" title="@Ui.When(e.Turn, null)">@Calendar.Short(e.Turn)</small> @Ui.Dated(e.Text, null)</div>
}

@code {
    [Parameter, EditorRequired] public GameRunner Runner { get; set; } = default!;
    private Power Left = Power.Egypt;
    private Power Right = Power.Hatti;

    protected override void OnParametersSet()
    {
        var winners = Runner.State.Winners.Select(w => Enum.TryParse<Power>(w, out var p) ? p : Power.Egypt).ToList();
        if (winners.Count > 0 && !_set)
        {
            Left = winners[0];
            Right = Powers.All.First(p => p != Left);
            _set = true;
        }
    }

    private bool _set;
}
