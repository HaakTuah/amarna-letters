@* The spectator's message trail: what the leader wrote, what the envoy said abroad, what it reported home. *@
@{
    var trails = State.Trails.Where(t => Filter is null || t.From == Filter || t.To == Filter).OrderByDescending(t => t.Turn).ThenByDescending(t => TurnEngine.IdNumber(t.Id)).ToList();
}
<div class="row" style="justify-content:space-between;margin-bottom:.5rem">
    <h3 style="margin:0">Message trail</h3>
    <select value="@(Filter?.ToString() ?? "")" @onchange="e => Filter = string.IsNullOrEmpty((string?)e.Value) ? null : Enum.Parse<Power>((string)e.Value!)">
        <option value="">All powers</option>
        @foreach (var p in Powers.All) { <option value="@p">@p.Name()</option> }
    </select>
</div>
<p class="muted">Three versions of every message. The gaps between them are the game.</p>
@if (trails.Count == 0) { <p class="muted">No envoy has set out yet.</p> }
@foreach (var t in trails.Take(Limit))
{
    var envoy = State.FindCharacter(t.EnvoyId);
    var status = Status(t, envoy);
    <div class="card trail-card">
        <div class="trail-head">
            <strong><Emblem Power="t.From" /> @t.From.Name() → <Emblem Power="t.To" /> @t.To.Name()</strong>
            <small class="muted">sent @Ui.When(t.Turn, null)@(t.AudienceTurn is int a ? $" · heard {Ui.When(a, null)}" : "")@(t.ReportTurn is int r ? $" · reported {Ui.When(r, null)}" : "")</small>
            <button class="small link" @onclick="() => OnPerson.InvokeAsync(t.EnvoyId)">Follow @t.EnvoyName</button>
        </div>
        @if (status is not null) { <p class="trail-status">@status</p> }
        @if (t.GreetingText.Length > 0) { <div class="tablet" style="margin:.4rem 0;font-size:.88rem">@t.GreetingText</div> }
        else { <p class="muted"><em>The tablet carried no greeting.</em></p> }
        <div class="trail">
            <div><h5>The king wrote</h5>@t.LeaderLetter@if (t.Mandate.Length > 0) {<br /><br /><small class="muted">Mandate: @t.Mandate</small>}@if (t.GoldStated > 0) {<br /><small class="muted">Gold: @Ui.Shekels(t.GoldStated) stated</small>}@if (t.ProposalText is not null) {<br /><small class="muted">Tablet to seal: @t.ProposalText</small>}</div>
            <div><h5>The envoy said abroad</h5>@if (t.AudienceTurn is null) {<span class="muted">Not yet heard.</span>} else {@(t.Delivered.Length > 0 ? t.Delivered : "(nothing was said)")}@foreach (var x in t.Exchanges) {<br /><br /><small class="muted">Host:</small> @x.Host@if (x.Envoy.Length > 0) {<br /><small class="muted">Envoy:</small> @x.Envoy}}@if (t.GoldStated > 0 && t.AudienceTurn is not null) {<br /><br /><small class="muted">Weighed @Ui.Shekels(t.GoldDelivered), fine gold @Ui.Shekels(t.GoldFine)</small>}</div>
            <div><h5>The envoy reported home</h5>@if (t.ReportTurn is not null) {@(t.Report.Length > 0 ? t.Report : "(no report)")} else {<span class="muted">No report yet.</span>}</div>
        </div>
        @if (t.Outcomes.Count > 0) { <p style="margin:.4rem 0 0"><small><strong>What happened:</strong> @string.Join("; ", t.Outcomes)</small></p> }
        @if (envoy is not null)
        {
            <details><summary><small>@envoy.Name's hidden traits</small></summary>
                <small>Loyalty @envoy.Traits.Loyalty · greed @envoy.Traits.Greed · competence @envoy.Traits.Competence · ambition @envoy.Traits.Ambition · courage @envoy.Traits.Courage@(envoy.Traits.Sympathy is { } s ? $" · sympathy for {s} ({envoy.Traits.SympathyStrength})" : "")@(envoy.SecretMaster is { } sm ? $" · secretly serves {sm}" : "")</small>
            </details>
        }
    </div>
}
@if (trails.Count > Limit) { <button @onclick="() => Limit += 20">Show more</button> }

@code {
    [Parameter, EditorRequired] public GameState State { get; set; } = default!;
    [Parameter] public EventCallback<string> OnPerson { get; set; }
    private Power? Filter;
    private int Limit = 20;

    /// <summary>
    /// Where the message stands while it is unfinished, instead of empty dashes: on the road and when it arrives, at the
    /// court, on the road home and when it is back, detained, held, gone over to another court, or dead.
    /// </summary>
    private string? Status(MessageTrail t, Character? envoy)
    {
        if (t.ReportTurn is not null) return null;
        var journey = State.Journeys.FirstOrDefault(j => j.CharacterId == t.EnvoyId
            && (j.Dispatch?.TrailId == t.Id || j.Cargo?.TrailId == t.Id));
        if (journey is { Kind: JourneyKind.EnvoyOutbound })
            return $"On the road, arrives in {Ui.When(journey.ArriveTurn, null)}.";
        if (journey is { Kind: JourneyKind.EnvoyHomebound })
            return $"Heard; on the road home, back in {Ui.When(journey.ArriveTurn, null)}.";
        if (envoy is null) return null;
        if (envoy.Status == CharacterStatus.Dead) return "Never came home: the envoy is dead.";
        if (envoy.Status == CharacterStatus.Captured && envoy.HeldBy is { } jailer) return $"Never came home: held captive by {jailer.Name()}.";
        if (envoy.Duty == Duty.Detained || envoy.HeldBy is not null) return $"Detained at the court of {(envoy.HeldBy ?? t.To).Name()}.";
        if (envoy.Duty == Duty.EnvoyAtCourt && envoy.CurrentTrail == t.Id) return $"At the court of {t.To.Name()}.";
        if (envoy.Employer != t.From) return envoy.Employer is { } now ? $"Never reported: went over to {now.Name()}." : "Never reported: left the king's service.";
        return t.AudienceTurn is null ? "Not heard." : null;
    }
}
