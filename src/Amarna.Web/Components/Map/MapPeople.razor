@* People and gold: envoys at foreign courts (tablets), spies at their posts (eyes), captives (fetters), envoys whose
   court has lost them ("?"), travellers on the road at a guessed place with a soft halo (it is a guess), gold shipments
   as oxhide ingots, and in a court's view the rumours and spy reports it has received, faint and dashed (word, not
   sight). A tap follows the person. *@
@using Amarna.Web.Components.Map
<g class="people">
    @foreach (var group in Scene.People.GroupBy(x => x.Province))
    {
        var city = MapArt.City(group.Key);
        var list = group.ToList();
        <g @key="@($"at:{group.Key}")" transform="@($"translate({F(city.X)},{F(city.Y)})")">
            <g class="sym">
                @for (var i = 0; i < Math.Min(list.Count, 6); i++)
                {
                    var p = list[i];
                    var angle = (196 - 34 * i) * Math.PI / 180;
                    var x = Math.Cos(angle) * 27;
                    var y = -Math.Sin(angle) * 27 + 4;
                    <g @key="p.Id" class="@($"person k-{p.Kind.ToString().ToLowerInvariant()}{(p.Believed ? " believed" : "")}{(p.Id == FollowId ? " followed" : "")}")"
                       transform="@($"translate({F(x)},{F(y)})")" @onclick="() => OnPerson.InvokeAsync(p.Id)" @onclick:stopPropagation>
                        <title>@p.Title</title>
                        <rect class="@($"chip-bg {(p.Owner is { } o ? $"f-{Glyphs.Id(o)}" : "f-none")}")" x="-8" y="-8" width="16" height="16" rx="3.5" />
                        @switch (p.Kind)
                        {
                            case PersonKind.Envoy: <use href="#g-tablet" class="chip-icon" x="-6" y="-6" width="12" height="12" /> break;
                            case PersonKind.Spy: <use href="#g-eye" class="chip-icon" x="-6.5" y="-6.5" width="13" height="13" /> break;
                            case PersonKind.Captive: <use href="#g-fetter" class="chip-icon" x="-6.5" y="-6.5" width="13" height="13" /> break;
                            default: <g><text class="chip-q" y="4">?</text></g> break;
                        }
                        @if (p.Double)
                        {
                            <circle class="double" cx="7" cy="-7" r="3" />
                        }
                    </g>
                }
                @if (list.Count > 6)
                {
                    <g><text class="chip-more" x="-34" y="18">+@(list.Count - 6)</text></g>
                }
            </g>
        </g>
    }
    @foreach (var n in Scene.News)
    {
        var at = MapArt.City(n.Province);
        <g @key="@($"n:{n.Province}:{n.Kind}")" class="@($"news age{Math.Min(n.Age, 4)} {(n.Kind == InboxKind.SpyReport ? "report" : "rumor")}")" transform="@($"translate({F(at.X + 20)},{F(at.Y + 10)})")">
            <title>@($"{n.Title} ({(n.Kind == InboxKind.SpyReport ? $"observed in {Calendar.Label(n.Observed, Viewer)}" : $"heard in {Calendar.Label(Math.Max(1, Scene.Index + 1 - n.Age), Viewer)}")}): {n.Body}")</title>
            <g class="sym">
                <path class="news-bg" d="M-9,-7H9V5H2L-2,9V5H-9Z" />
                @if (n.Kind == InboxKind.SpyReport)
                {
                    <use href="#g-eye" class="news-icon" x="-6" y="-7" width="12" height="12" />
                }
                else
                {
                    <g><text class="news-q" y="3">?</text></g>
                }
            </g>
        </g>
    }
    @foreach (var (t, i) in Scene.Travellers.Select((t, i) => (t, i)))
    {
        var route = MapArt.Route(t.FromProvince, t.ToProvince);
        var at = MapArt.Along(route, t.Progress);
        // Travellers on the same road are spread a little apart.
        var same = Scene.Travellers.Take(i).Count(o => o.FromProvince == t.FromProvince && o.ToProvince == t.ToProvince);
        var shift = (route.Length > 1 ? (route[^1] - route[0]).Unit.Normal : new Pt(0, 1)) * (same * 14);
        at += shift;
        var icon = t.Kind switch { TravellerKind.Spy => "#g-eye", TravellerKind.Gold => "#g-ingot", _ => "#g-tablet" };
        <g @key="t.Key" class="@($"traveller k-{t.Kind.ToString().ToLowerInvariant()}{(t.Believed ? " believed" : "")}{(t.CharacterId is not null && t.CharacterId == FollowId ? " followed" : "")}")"
           style="@($"transform:translate({F(at.X)}px,{F(at.Y)}px)")" @onclick="() => Clicked(t)" @onclick:stopPropagation>
            <title>@($"{t.Title}; set out in {Calendar.Label(t.Depart, Viewer)}, due {(t.Believed ? "back" : "there")} about {Calendar.Label(t.Arrive, Viewer)}{(t.Gold > 0 && t.Kind != TravellerKind.Gold ? $"; carries {Ui.Shekels(t.Gold)} of gold" : "")}. Where on the road is a guess.")</title>
            <g class="sym">
                <circle class="halo" r="15" />
                @if (t.Kind == TravellerKind.Gold)
                {
                    <use href="#g-ingot" class="@($"ingot e-{Glyphs.Id(t.Owner)}")" x="-10" y="-10" width="20" height="20" />
                }
                else
                {
                    <rect class="@($"chip-bg f-{Glyphs.Id(t.Owner)}")" x="-8.5" y="-8.5" width="17" height="17" rx="8.5" />
                    <use href="@icon" class="chip-icon" x="-6.5" y="-6.5" width="13" height="13" />
                    @if (t.Gold > 0)
                    {
                        <use href="#g-ingot" class="ingot small" x="3" y="2" width="10" height="10" />
                    }
                }
                <text class="eta" y="21">@($"→ {Calendar.Short(t.Arrive, Viewer)}")</text>
            </g>
        </g>
    }
</g>

@code {
    [Parameter, EditorRequired] public MapScene Scene { get; set; } = default!;
    [Parameter] public Power? Viewer { get; set; }
    [Parameter] public string? FollowId { get; set; }
    [Parameter] public EventCallback<string> OnPerson { get; set; }

    private (MapScene?, string?) _drawn;

    protected override bool ShouldRender() => _drawn != (Scene, FollowId);

    protected override void OnAfterRender(bool firstRender) => _drawn = (Scene, FollowId);

    private static string F(double v) => MapArt.F(v);

    private Task Clicked(SceneTraveller t) => t.CharacterId is { } id ? OnPerson.InvokeAsync(id) : Task.CompletedTask;
}
