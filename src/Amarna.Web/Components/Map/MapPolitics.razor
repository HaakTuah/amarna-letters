@* Who holds each province, drawn as known: ownership is public and live in the engine, so it is never faded by age.
   Three parts, drawn at three depths: the tints (which also catch taps), the border lines (each power its own line, so
   borders read without colour), and the cities (each with its owner's emblem, a crown for a capital, a ring of walls
   for a walled city). Redrawn only when another season is shown. *@
@using Amarna.Web.Components.Map
@switch (Part)
{
    case "tints":
        <g class="politics" clip-path="url(#seaclip)">
            @foreach (var p in Seas)
            {
                <path @key="p.Id" class="hit sea-hit" d="@MapArt.Shapes[p.Id]" @onclick="() => OnProvince.InvokeAsync(p.Id)"><title>@p.Name, a sea zone</title></path>
            }
        </g>
        <g class="politics" clip-path="url(#landclip)">
            @foreach (var p in Land)
            {
                var owner = Frame.OwnerOf(p.Id);
                <path @key="p.Id" class="@(owner is { } o ? $"tint t-{Glyphs.Id(o)}" : "tint free")" d="@MapArt.Shapes[p.Id]" @onclick="() => OnProvince.InvokeAsync(p.Id)">
                    <title>@Title(p, owner)</title>
                </path>
            }
        </g>
        break;
    case "bands":
        <g class="bands" clip-path="url(#landclip)">
            @foreach (var p in Land)
            {
                if (Frame.OwnerOf(p.Id) is not { } o) continue;
                <path @key="p.Id" class="@($"band b-{Glyphs.Id(o)}")" d="@MapArt.Shapes[p.Id]" clip-path="@($"url(#cl-{p.Id})")" stroke-dasharray="@Glyphs.Dash(o)" />
            }
        </g>
        break;
    default:
        <g class="cities">
            @foreach (var p in Land)
            {
                var owner = Frame.OwnerOf(p.Id);
                var walls = Frame.Walls.GetValueOrDefault(p.Id);
                var besieged = Sieges.Contains(p.Id);
                <g @key="p.Id" transform="@($"translate({p.X},{p.Y})")" class="@($"city{(p.Capital ? " capital" : "")}{(owner is null ? " free" : "")}{(besieged ? " besieged" : "")}")" @onclick="() => OnProvince.InvokeAsync(p.Id)">
                    <g class="csym">
                        @if (walls > 0)
                        {
                            @* One ring for each level of walls standing. *@
                            @for (var level = walls; level >= 1; level--)
                            {
                                <circle class="@($"walls w{level}")" r="@((p.Capital ? 12 : 8.5) + 2 * level)" />
                            }
                        }
                        @if (p.Capital)
                        {
                            <circle class="cap-ring" r="12.6" />
                        }
                        <circle class="@($"seal {(owner is { } so ? $"s-{Glyphs.Id(so)}" : "s-free")}")" r="@(p.Capital ? 9.5 : 7.5)" />
                        @if (owner is { } eo)
                        {
                            <use href="@($"#em-{Glyphs.Id(eo)}")" class="seal-em" x="@(p.Capital ? -7 : -5.5)" y="@(p.Capital ? -7 : -5.5)" width="@(p.Capital ? 14 : 11)" height="@(p.Capital ? 14 : 11)" />
                        }
                    </g>
                </g>
            }
        </g>
        break;
}

@code {
    private static readonly WorldMap Map = WorldMap.Default;
    private static readonly IReadOnlyList<Province> Seas = Map.Provinces.Where(p => p.IsSea && MapArt.Shapes.ContainsKey(p.Id)).ToList();
    private static readonly IReadOnlyList<Province> Land = Map.LandProvinces.Where(p => MapArt.Shapes.ContainsKey(p.Id)).ToList();

    [Parameter, EditorRequired] public SeasonFrame Frame { get; set; } = default!;
    /// <summary>"tints", "bands" or "cities".</summary>
    [Parameter] public string Part { get; set; } = "tints";
    [Parameter] public EventCallback<string> OnProvince { get; set; }
    /// <summary>The cities besieged that the viewer knows of, drawn with broken walls (a court knows only the sieges in its view).</summary>
    [Parameter] public IReadOnlySet<string> Sieges { get; set; } = new HashSet<string>();

    private SeasonFrame? _drawn;
    private string _sieges = "";

    private string SiegeKey => string.Join(",", Sieges.Order(StringComparer.Ordinal));

    protected override bool ShouldRender() => !ReferenceEquals(_drawn, Frame) || _sieges != SiegeKey;

    protected override void OnAfterRender(bool firstRender)
    {
        _drawn = Frame;
        _sieges = SiegeKey;
    }

    private static string Title(Province p, Power? owner) =>
        $"{p.Name}: {(owner is { } o ? $"held by {o.Name()}" : "a free city-state")}; yields {Ui.Shekels(p.Yield)} a season"
        + (Geography.TerrainOf(p.Id) switch { Terrain.Rough => "; rough ground: a unit standing its ground here is stronger", Terrain.Desert => "; desert", _ => "" });
}
