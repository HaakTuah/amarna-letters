@* Fog of war as a gradient, in a court's view: provinces in sight are clear; those seen before fade by how long ago,
   and those never seen are veiled most. It veils what the court saw there (troops), not who holds the land: ownership
   stays drawn as known above it. God view draws no fog. *@
@using Amarna.Web.Components.Map
@if (Scene.Viewer is not null)
{
    @foreach (var (group, clip, fill) in Groups)
    {
        <g class="fog" clip-path="@clip">
            @foreach (var p in group)
            {
                var age = Scene.FogAge.TryGetValue(p.Id, out var a) ? a : -1;
                if (age == 0) continue;
                <path @key="p.Id" class="@($"veil-{Level(age)}{(p.IsSea ? " sea" : "")}")" d="@MapArt.Shapes[p.Id]" fill="@(age < 0 ? fill : null)" />
            }
        </g>
    }
    @* When the map is zoomed in, each province seen before carries the season the court last saw it. *@
    <g class="fogdates">
        @foreach (var p in Provinces)
        {
            if (!Scene.FogAge.TryGetValue(p.Id, out var age) || age == 0) continue;
            var at = MapArt.City(p.Id);
            <g @key="p.Id" transform="@($"translate({MapArt.F(at.X)},{MapArt.F(at.Y)})")"><text class="fogdate" y="@(p.IsSea ? 18 : 33)">@($"seen {Calendar.Short(Scene.Index - age + 1, Scene.Viewer)}")</text></g>
        }
    </g>
}

@code {
    private static readonly IReadOnlyList<Province> Provinces = WorldMap.Default.Provinces.Where(p => MapArt.Shapes.ContainsKey(p.Id)).ToList();
    private static readonly (List<Province>, string, string)[] Groups =
    [
        (Provinces.Where(p => !p.IsSea).ToList(), "url(#landclip)", "url(#fog)"),
        (Provinces.Where(p => p.IsSea).ToList(), "url(#seaclip)", "url(#fogsea)"),
    ];

    [Parameter, EditorRequired] public MapScene Scene { get; set; } = default!;

    private MapScene? _drawn;

    protected override bool ShouldRender() => !ReferenceEquals(_drawn, Scene);

    protected override void OnAfterRender(bool firstRender) => _drawn = Scene;

    /// <summary>1: seen last season; 2: two or three seasons ago; 3: four or more; 4: never seen.</summary>
    public static int Level(int age) => age < 0 ? 4 : age <= 1 ? 1 : age <= 3 ? 2 : 3;
}
