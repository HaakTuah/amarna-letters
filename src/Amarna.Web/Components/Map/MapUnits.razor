@* The armies (chariots, on square tokens) and fleets (ships, on round ones), in their owner's colour with its emblem,
   a count when several stand together. Each keeps its key from season to season, so stepping the timeline slides it
   along its move. In a court's view, a ghost is a unit the court saw there before and cannot see now: an outline,
   fainter the older it is, with the season it was seen. *@
@using Amarna.Web.Components.Map
<g class="units">
    @foreach (var u in Scene.Units)
    {
        var at = MapArt.UnitSpot(u.Province);
        var id = Glyphs.Id(u.Power);
        <g @key="u.Key" class="@($"unit{(u.Ghost ? $" ghost age{Math.Min(u.Age, 4)}" : "")}")" style="@($"transform:translate({F(at.X)}px,{F(at.Y)}px)")" @onclick="() => OnProvince.InvokeAsync(u.Province)">
            <title>@Title(u)</title>
            <g class="sym lift">
                @if (u.Kind == UnitKind.Army)
                {
                    <rect class="@($"tok-bg f-{id}")" x="-11" y="-11" width="22" height="22" rx="4" />
                }
                else
                {
                    <circle class="@($"tok-bg f-{id}")" r="12" />
                }
                <use href="@(u.Kind == UnitKind.Army ? "#g-army" : "#g-fleet")" class="tok-icon" x="-9.5" y="-9.5" width="19" height="19" />
                <g transform="translate(10,-10)">
                    <circle class="tok-badge" r="5.6" />
                    <use href="@($"#em-{id}")" class="@($"tok-em e-{id}")" x="-4.3" y="-4.3" width="8.6" height="8.6" />
                </g>
                @if (u.Count > 1)
                {
                    <g transform="translate(-10,10)"><circle class="tok-count" r="5.6" /><text class="tok-num" y="2.6">@u.Count</text></g>
                }
                @if (u.Ghost)
                {
                    <g><text class="seen" y="-15">@($"seen {Calendar.Short(u.SeenAt + 1, Viewer)}")</text></g>
                }
            </g>
        </g>
    }
</g>

@code {
    [Parameter, EditorRequired] public MapScene Scene { get; set; } = default!;
    [Parameter] public Power? Viewer { get; set; }
    [Parameter] public EventCallback<string> OnProvince { get; set; }

    private MapScene? _drawn;

    protected override bool ShouldRender() => !ReferenceEquals(_drawn, Scene);

    protected override void OnAfterRender(bool firstRender) => _drawn = Scene;

    private static string F(double v) => MapArt.F(v);

    private string Title(SceneUnit u) =>
        (u.Count > 1 ? $"{u.Count} {MapScene.Kind(u.Kind)}s" : $"{(u.Kind == UnitKind.Army ? "An army" : "A fleet")}")
        + $" of {u.Power.Name()} in {Ui.Province(u.Province)}"
        + (u.Ghost ? $": last seen there in {Calendar.Label(u.SeenAt + 1, Viewer)}, {u.Age} season{(u.Age == 1 ? "" : "s")} ago; it may have moved since" : "");
}
