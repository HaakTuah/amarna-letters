@{
    var map = WorldMap.Default;
    var p = map[Id];
    var owner = State.Owner.GetValueOrDefault(Id);
    var unit = View is null ? State.UnitAt(Id) is { } u ? new UnitView { Power = u.Power, Kind = u.Kind, Province = u.Province } : null
                            : View.Units.FirstOrDefault(x => x.Province == Id);
}
<div class="card" style="margin-top:.5rem">
    <h3>@p.Name @if (p.Capital) { <small class="muted">· capital</small> }</h3>
    @if (p.IsSea)
    {
        <p class="muted">A sea zone. Fleets move through it; fleets here can convoy armies across.</p>
    }
    else
    {
        <p>
            @(owner is { } o ? $"Held by {o.Name()}." : "A free city-state.")
            Yields @Ui.Shekels(p.Yield) a season@(p.Home is { } h && h != owner ? $"; part of the homeland of {h.Name()}" : "").
            @if (State.Garrisons.Contains(Id) && owner is null) { <span> Its walls hold against a single army: take it with support, or buy it for @Ui.Shekels(p.Yield * State.Config.NeutralPriceFactor).</span> }
            else if (State.Garrisons.Contains(Id)) { <span> It accepted @owner?.Name()'s gold, and its walls hold for its owner.</span> }
        </p>
    }
    @if (unit is not null)
    {
        <p><span class="dot" style="background:@Ui.Color(unit.Power)"></span> @(unit.Kind == UnitKind.Army ? "An army" : "A fleet") of @unit.Power.Name() stands here.</p>
    }
    else if (View is not null && !View.Visible.Contains(Id))
    {
        <p class="muted">Beyond your sight: you cannot see troops here.</p>
    }
    <small class="muted">Neighbours: @string.Join(", ", map.Neighbors(Id).Distinct().Select(Ui.Province))</small>
</div>

@code {
    [Parameter, EditorRequired] public GameState State { get; set; } = default!;
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter] public SeatView? View { get; set; }
}
