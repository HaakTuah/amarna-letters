@* "Follow this character": one person's life as the current view may know it, with their path drawn on the map. *@
@using Amarna.Web.Services
@if (!Record.Known)
{
    <h3>@Record.Name</h3>
    <p class="muted">@Record.Now</p>
}
else
{
    <div class="follow-head">
        <Emblem Power="Record.Employer" />
        <div>
            <h3>@Record.Name <small class="muted">@Record.Subtitle</small></h3>
            <p class="small">@Record.Now</p>
        </div>
    </div>
    <p class="muted small">Their path up to the season shown is drawn on the map; step the timeline to walk it. @(Viewer is { } v ? $"Only what {v.Name()} knows is shown." : "")</p>
    @foreach (var s in Record.Sections)
    {
        <h4>@s.Title</h4>
        @if (s.Note is not null) { <p class="muted small">@s.Note</p> }
        <ul class="life">
            @foreach (var e in s.Entries)
            {
                <li @onclick="() => { if (e.Province is { } at) OnProvince.InvokeAsync(at); }" class="@((e.Province is null ? "" : "tap ") + (e.From > 0 ? "" : "nodate"))">
                    @if (e.From > 0)
                    {
                        <span class="when" title="@Ui.When(e.From, Viewer)">@Calendar.Short(e.From, Viewer)@(e.Until is int u && u > e.From ? $" – {Calendar.Short(u, Viewer)}" : "")</span>
                    }
                    <span class="what">@e.Text</span>
                </li>
            }
        </ul>
    }
}
<button class="small" @onclick="OnClose">Stop following</button>

@code {
    [Parameter, EditorRequired] public LifeRecord Record { get; set; } = default!;
    [Parameter] public Power? Viewer { get; set; }
    [Parameter] public EventCallback<string> OnProvince { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}
